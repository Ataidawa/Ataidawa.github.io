<header class="page-head"><p class="page-eyebrow">JOPOLIS / CONNECTIONS</p><h1 class="page-title" aria-label="友链">Friends.</h1><p class="page-desc">不同的视角，有趣的连接。</p></header>
<% var friends=site.data.friends || []; %>
<% if(friends.length) { %>
<div class="friends-grid">
<% friends.forEach(function(friend) { %>
  <a class="friend-card" href="<%= friend.url %>" target="_blank" rel="noopener noreferrer">
    <% if(friend.avatar) { %><img src="<%= url_for(friend.avatar) %>" alt="" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false"><span class="friend-avatar" aria-hidden="true" hidden><%= friend.name.slice(0,1) %></span><% } else { %><span class="friend-avatar" aria-hidden="true"><%= friend.name.slice(0,1) %></span><% } %>
    <div><h2><%= friend.name %></h2><p><%= friend.description %></p></div><span aria-hidden="true">↗</span>
  </a>
<% }); %>
</div>
<% } else { %>
<section class="friends-empty"><span class="empty-symbol" aria-hidden="true">↗</span><h2>给有趣的朋友留个位置</h2><p>友链正在整理中，期待在这里遇见更多创作者。</p><a class="hero-link" href="#contact">联系我</a></section>
<% } %>
