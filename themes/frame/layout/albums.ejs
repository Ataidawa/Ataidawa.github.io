<header class="page-head"><p class="page-eyebrow">JOPOLIS / MOMENTS</p><h1 class="page-title">相册簿</h1><p class="page-desc">把灵感、过程和日常，留在画面里。</p></header>
<% (site.data.albums || []).forEach(function(album) { %>
<section class="album-section">
  <div class="album-heading"><div><h2><%= album.title %></h2><p><%= album.description %></p></div><span class="content-chip"><%= album.photos.length %> 张<%= album.placeholder ? ' · 占位预览' : '' %></span></div>
  <div class="album-grid">
  <% album.photos.forEach(function(photo) { %>
    <figure class="album-photo"><div class="album-image"><img src="<%= url_for(photo.image) %>" alt="<%= photo.caption %>" loading="lazy"></div><figcaption><%= photo.caption %></figcaption></figure>
  <% }); %>
  </div>
</section>
<% }); %>
