<%
  var portfolio = site.data.portfolio || [];
  var items = [];
  var allWorks = [];
  portfolio.forEach(function(item){
    var cat = site.categories.findOne({ name: item.name });
    var posts = cat ? cat.posts.sort('-date').toArray() : [];
    items.push({ name: item.name, count: posts.length, path: cat ? cat.path : '#' });
    posts.forEach(function(p){
      allWorks.push({ post: p, catName: item.name });
    });
  });
  allWorks.sort(function(a, b){ return b.post.date.valueOf() - a.post.date.valueOf(); });
  var total = allWorks.length;
%>
<div class="page-head">
  <p class="page-eyebrow">JOPOLIS / DESIGN ARCHIVE</p>
  <h1 class="page-title" aria-label="作品集">Portfolio.</h1>
  <p class="page-desc"><%= items.length %> 个类目 · <%= total %> 个项目，按类目浏览</p>
</div>

<div class="tag-filter">
  <button class="tag-btn is-active" type="button" data-filter="" aria-pressed="true">全部 <span class="tag-btn-count"><%= total %></span></button>
  <% items.forEach(function(item){ %>
    <button class="tag-btn" type="button" data-filter="<%= item.name %>" aria-pressed="false">
      <span class="tag-btn-name"><%= item.name %></span>
      <span class="tag-btn-count"><%= item.count %></span>
    </button>
  <% }); %>
</div>

<div class="work-grid-head">
  <h2>全部作品</h2>
  <span id="work-count" aria-live="polite"><%= total %> 个项目</span>
</div>

<div class="work-grid">
  <% allWorks.forEach(function(w){ %>
    <a class="work-grid-item" data-category="<%= w.catName %>" href="<%= url_for(w.post.path) %>">
      <div class="work-grid-img">
        <% if (w.post.featured_image) { %>
          <img src="<%= url_for(w.post.featured_image) %>" alt="<%= w.post.title %>">
        <% } %>
      </div>
      <div class="work-grid-meta">
        <span class="work-grid-cat"><%= w.catName %></span>
        <h3 class="work-grid-title"><%= w.post.title %></h3>
      </div>
    </a>
  <% }); %>
</div>
